# CustomVideoCall plugin (IC project): audio + video calls between users,
# on this Janus server or on any other Janus server on the LAN. Built from the
# same source as the AudioCall plugin; it uses its OWN link port (default 7089).
#
# events = true|false, whether events should be sent to event handlers
#
# Link to the other Janus servers. Nothing about them is configured: every
# server broadcasts an announcement on the LAN every 2 seconds, and learns
# the others (and who is registered on them) from their announcements.
# server_name = name of THIS server, must be unique (default: the host name)
# link_port   = UDP port of the link, the SAME on every server (7089);
#               0 disables the link (local calls only)
# ws_port     = WebSocket port of this Janus, told to apps that discover
#               the servers (default 8188)
# public_host = address apps on the INTERNET use to reach this server, e.g.
#               its public IP. It is shared with the other servers and
#               returned in "list", so an app that reaches any one server
#               learns all of them. Leave unset on a LAN-only setup.

general: {
	#events = false
	#server_name = "pc1"
	#link_port = 7089
	#ws_port = 8188
	#public_host = "203.0.113.10"
}
