# CustomVideoCall plugin (IC project): audio + video calls between users,
# on this Janus server or on a peer Janus server. Built from the same source
# as the AudioCall plugin; it uses its OWN peer link port (default 7089).
#
# events = true|false, whether events should be sent to event handlers
#
# Peer link (to the CustomVideoCall plugin on the other Janus server):
# server_name = name of THIS server, shown in logs and replies
# link_port   = UDP port this plugin listens on for the peer link
# peer_host   = IPv4 address of the other Janus server (leave unset to
#               disable the peer link and allow local calls only)
# peer_port   = UDP port the other server's plugin listens on

general: {
	#events = false
	#server_name = "pc1"
	#link_port = 7089
	#peer_host = "192.168.99.112"
	#peer_port = 7089
}
